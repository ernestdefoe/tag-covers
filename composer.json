{
    "name": "ernestdefoe/tag-covers",
    "description": "Cover images for Flarum tags — upload a cover per tag and use it anywhere a tag is rendered as a card.",
    "keywords": [
        "flarum",
        "flarum-extension",
        "tags",
        "covers",
        "images"
    ],
    "type": "flarum-extension",
    "license": "proprietary",
    "authors": [
        {
            "name": "Ernest Defoe",
            "email": "ernestdefoe@gmail.com"
        }
    ],
    "require": {
        "php": "^8.3",
        "flarum/core": "^2.0",
        "flarum/tags": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Ernestdefoe\\TagCovers\\": "src/"
        }
    },
    "extra": {
        "flarum-extension": {
            "title": "Tag Covers",
            "category": "feature",
            "icon": {
                "name": "fas fa-image",
                "backgroundColor": "#0ea5e9",
                "color": "#fff"
            }
        }
    }
}
